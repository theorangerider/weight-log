{
  "name": "weight-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hacker's Diet style weight logging and trend tracking",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:node": "ALLOW_REGISTRATION=true node --watch server/main.js",
    "start": "node server/main.js",
    "image": "sh scripts/build-image.sh",
    "user": "node server/cli.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20260730.1": true
  }
}
